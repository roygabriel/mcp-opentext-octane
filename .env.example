# OpenText Octane MCP Server Configuration

# Octane server URL (required)
OCTANE_URL=

# Shared space ID (required, numeric)
OCTANE_SHARED_SPACE_ID=

# Workspace ID (required, numeric)
OCTANE_WORKSPACE_ID=

# Authentication: API Key (preferred)
OCTANE_CLIENT_ID=
OCTANE_CLIENT_SECRET=

# Authentication: Username/Password (alternative if API key not available)
# OCTANE_USERNAME=
# OCTANE_PASSWORD=
